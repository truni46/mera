# Production overrides (VPS)
# Copy to .env.production and fill in your domain
# Activated when APP_ENV=production (set in docker-compose.prod.yml)

DOMAIN=your-domain.com

# --- Frontend ---
VITE_API_URL=http://your-domain.com/api/v1
VITE_SOCKET_URL=http://your-domain.com

# --- Server ---
FRONTEND_URL=http://your-domain.com

# --- Database (overridden by docker-compose environment: block) ---
DB_HOST=db

# --- Redis (overridden by docker-compose environment: block) ---
REDIS_HOST=redis

# --- Object Storage (Cloudflare R2) ---
# When R2_ENABLED=true, new uploads are stored in Cloudflare R2 instead of the
# local data/uploads dir. Existing local documents keep working unchanged.
# Create credentials at https://dash.cloudflare.com -> R2 -> Manage R2 API Tokens.
R2_ENABLED=false
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=mera
R2_REGION=auto
# Optional - derived from R2_ACCOUNT_ID when empty:
# R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# Optional - max concurrent OCR/index background tasks per process (default 4):
# DOC_PROCESSING_CONCURRENCY=4
