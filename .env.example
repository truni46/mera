# Environment loading order:
#   1. .env                  — base config (local dev defaults)
#   2. .env.{APP_ENV}        — environment override (e.g. .env.production)
#   3. .env.local            — personal override (never committed)
#
# Usage:
#   Local dev:  just use .env (APP_ENV defaults to "local")
#   Docker:     docker-compose sets DB_HOST/REDIS_HOST via environment: block
#   VPS prod:   set APP_ENV=production → loads .env then .env.production

DOMAIN=localhost

# --- Frontend (Vite — baked at build time) ---
VITE_API_URL=http://localhost:3000/api/v1
VITE_SOCKET_URL=http://localhost:3000

# --- Server ---
PORT=3000
HOST=0.0.0.0
FRONTEND_URL=http://localhost:5173

# --- Auth ---
JWT_SECRET=change-this-to-a-secure-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database (PostgreSQL) ---
# Run server/scripts/migrate_db.sh to create DB_NAME and apply the schema.
USE_DATABASE=true
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mera
DB_USER=admin
DB_PASSWORD=your_db_password

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0

# --- LLM ---
# Options: ollama | openai | gemini | gemini_native | vllm
LLM_PROVIDER=ollama
LLM_MODEL=mistral
OLLAMA_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=EMPTY

# --- Embedding ---
# Options: ollama | openai | generic
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
OPENAI_EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# --- Vector DB (Qdrant) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- Knowledge Graph (Neo4j) ---
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# --- RAG ---
# Options: simple (Qdrant only) | lightrag (requires Neo4j)
RAG_PROVIDER=simple
LIGHTRAG_QUERY_MODE=hybrid
LIGHTRAG_CHUNK_SIZE=1200
LIGHTRAG_CHUNK_OVERLAP=100
LIGHTRAG_STORAGE_DIR=./rag_storage

# --- Memory ---
CONV_SUMMARY_THRESHOLD=4000
CONV_WINDOW_SIZE=10
MEMORY_EXTRACTION_ENABLED=true
REDIS_CONV_WINDOW_TTL=3600
REDIS_SUMMARY_TTL=86400

# --- Agent System ---
AGENT_MAX_ITERATIONS=10
AGENT_WORKSPACE_DIR=./agent_workspace
AGENT_SHELL_TIMEOUT=30
TAVILY_API_KEY=tvly-...

# --- OCR ---
# OCR_PROVIDER: tesseract | paddle | paddle-vl | paddle-vl-cloud | vision
OCR_PROVIDER=paddle-vl
OCR_LANG=vie+eng
# PaddleOCR-VL via Baidu AI Studio API (model PaddleOCR-VL-1.5).
# Get URL + token at https://aistudio.baidu.com/paddleocr/task (click "API" on the model card).
# When both are set with OCR_PROVIDER=paddle-vl, it auto-routes to the cloud API.
PADDLEOCR_VL_API_URL=
PADDLEOCR_VL_ACCESS_TOKEN=
# PADDLEOCR_VL_TIMEOUT=180
# PADDLEOCR_VL_PRETTIFY=true

# --- Object Storage (Cloudflare R2) ---
# When R2_ENABLED=true, new uploads are stored in Cloudflare R2 instead of the
# local data/uploads dir. Existing local documents keep working unchanged.
# Create credentials at https://dash.cloudflare.com -> R2 -> Manage R2 API Tokens.
R2_ENABLED=false
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=mera
R2_REGION=auto
# Optional - derived from R2_ACCOUNT_ID when empty:
# R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# Optional - max concurrent OCR/index background tasks per process (default 4):
# DOC_PROCESSING_CONCURRENCY=4

# --- Token Quota ---
TOKEN_SESSION_LIMIT=500000
TOKEN_SESSION_DURATION=7200
TOKEN_WEEKLY_LIMIT=5000000
TOKEN_WARNING_THRESHOLD=0.9
